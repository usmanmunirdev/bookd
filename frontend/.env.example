# Base URL of the Bookd backend API that this frontend talks to.
VITE_API_BASE_URL=

# OAuth client ID for "Sign in with Google", from the Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable (public) key used to initialize Stripe.js on the client.
# This is safe to expose in client-side code; do not put a secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=
