# Copy this file to .env and fill in real values.
# A running PostgreSQL instance is required for the app to start.
# Third-party API keys are only required for the features that use them
# (see README.md for details).

# --- Server ---
PORT=

# --- Frontend ---
# Base URL of the Bookd frontend app, used for building links (e.g. in emails)
# and for CORS configuration.
FRONTEND_URL=

# --- Security ---
# Secret used to sign JSON Web Tokens for authenticated requests.
JWT_SECRET=
# Secret used to encrypt/decrypt sensitive stored data (e.g. tokens).
ENCRYPTION_SECRET=

# --- PostgreSQL / TypeORM ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Google OAuth (Google Calendar integration) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- OpenAI (chat / AI assistant) ---
OPENAI_API_KEY=

# --- Stripe (payments) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Hotelbeds (hotel search/booking) ---
HOTELBED_API_KEY=
HOTELBED_SHARED_KEY=

# --- Amadeus (flight search/booking) ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# --- Twilio (SMS notifications) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- SMTP / SendGrid (email notifications) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
